{
  "manifest_version": 3,
  "name": "Tab Organizer Pro",
  "description": "Automatically organize tabs by similarity, split into windows, and manage tabs in a drag-and-drop dashboard.",
  "homepage_url": "https://github.com/zdirani88/tab-organizer",
  "version": "0.1.4",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Organizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
